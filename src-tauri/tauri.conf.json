{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PenumbraWrapper",
  "version": "1.1.0",
  "identifier": "penumbra-wrapper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMzc5Q0I4Q0FENTMxMzcKUldRM01kWEt1SnczOG02NFYrNDNlcU5ndzVNa2tVUEk0NDFVaWNmaWc4dHh1OUVIYTdCbzh3WFUK",
      "endpoints": [
        "https://github.com/coolishsec0175/penumbra-wrapper/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "PenumbraWrapper",
        "maximized": true,
        "minWidth": 800,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  }
}
